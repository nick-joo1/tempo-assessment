# --- Required -----------------------------------------------------------------
# GitHub personal access token used for the GraphQL API. Public data only needs a
# token with no scopes (classic) or "Public repositories (read-only)" (fine-grained).
GITHUB_TOKEN=

# --- Narrative endpoint ---------------------------------------------------------
# Without a key the service still runs; the narrative endpoint answers 503.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium            # low | medium | high | xhigh | max

# --- Optional -------------------------------------------------------------------
# HOST=127.0.0.1
# PORT=3000
# LOG_LEVEL=info
# DATABASE_PATH=./data/review-flow.db
# SYNC_LOOKBACK_DAYS=180       # history fetched per repository; bounds queryable periods
# SYNC_INTERVAL_MINUTES=15     # background refresh of tracked repositories; 0 disables
# MAX_TRACKED_REPOS=25
# ALLOW_PRIVATE_REPOS=false    # the API is unauthenticated, so private data is refused by default
